# Never commit real keys. Copy this file to .env for local use.
OPENAI_API_KEY=
COINGECKO_DEMO_API_KEY=
# COINGECKO_PRO_API_KEY=
# X_BEARER_TOKEN=

TRADER_PETE_MODEL=gpt-5.6-sol
TRADER_PETE_REASONING_EFFORT=medium
TRADER_PETE_MAX_NARRATIVES=3
TRADER_PETE_CANDIDATE_NARRATIVES=6
TRADER_PETE_CURRENCY=usd

# X is pay-per-use. It remains off until both a token and explicit opt-in are present.
TRADER_PETE_X_ENABLED=false
TRADER_PETE_X_MAX_QUERIES=4
TRADER_PETE_X_POSTS_PER_QUERY=20
